# ── RabbitMQ (tg-if subscriber) ──────────────────────
# Connection to the tg-if message broker for Telegram
# admin bot command routing.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Testing ──────────────────────────────────────────
# Path to a GBA ROM file for emulator integration tests.
# Falls back to tests/resources/*.gb if not set.
# GBA_TEST_ROM=

# ── Application ──────────────────────────────────────
# Paths for runtime configuration.
CONFIG_PATH=config/gba-streamer.yaml
ROM_PATH=roms/pokemon_yellow.gb
SAVE_DIR=saves/

# HTTP server binding.
HOST=0.0.0.0
PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Authorization ───────────────────────────────────
# Comma-separated Telegram user IDs with admin privileges.
# Admin users can run /start, /stop, /pause, /fifo, etc.
ADMIN_USER_IDS=

# ── WebRTC ──────────────────────────────────────────
# JSON array of ICE servers (STUN/TURN) for WebRTC NAT
# traversal. Default: Google's public STUN (local/LAN only).
# ICE_SERVERS='[{"urls": ["stun:stun.l.google.com:19302"]}]'
