# ── RabbitMQ (tg-if subscriber) ──────────────────────
# Connection to the tg-if message broker for Telegram
# admin bot command routing.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Testing ──────────────────────────────────────────
# Path to a GBA ROM file for emulator integration tests.
# Falls back to tests/resources/*.gb if not set.
# GBA_TEST_ROM=

# ── Application ──────────────────────────────────────
# Paths for runtime configuration.
CONFIG_PATH=config/bots.yaml
ROM_PATH=roms/pokemon_yellow.gb
SAVE_DIR=saves/

# HTTP server binding.
HOST=0.0.0.0
PORT=8080
